{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "composite": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "database": ["../../packages/database/src/index"],
      "*": ["node_modules/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/database/src/**/*"
  ],
  "exclude": ["node_modules"]
}
