generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEALER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  PENDING
  SOLD
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  fullName      String?
  avatarUrl     String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listings      Car[]
  favorites     Favorite[]
  reviews       Review[]
  dealerProfile Dealer?
}

model Car {
  id            String      @id @default(uuid())
  sellerId      String
  seller        User        @relation(fields: [sellerId], references: [id])
  make          String
  model         String
  year          Int
  price         Decimal
  currency      String      @default("KES")
  mileage       Decimal?
  condition     Condition   @default(USED)
  status        CarStatus   @default(AVAILABLE)
  description   String?
  location      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  specs         CarSpecs?
  images        CarImage[]
  favorites     Favorite[]
  reviews       Review[]
  inspections   Inspection[]
}

model CarSpecs {
  id                  String   @id @default(uuid())
  carId               String   @unique
  car                 Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  // Basic Info
  trim                String?
  generation          String?
  bodyType            String?
  vehicleCategory     String?
  
  // Engine
  engineType          String?
  engineCc            Int?
  horsepower          Int?
  torque              Int?
  fuelType            String?
  turbocharged        Boolean  @default(false)
  supercharged        Boolean  @default(false)
  hybridSystem        String?
  
  // Transmission
  transmission        String?
  drivetrain          String?
  
  // Dimensions
  seatingCapacity     Int?
  doorCount           Int?
  
  // Features
  sunroof             Boolean  @default(false)
  appleCarplay        Boolean  @default(false)
  android_auto        Boolean  @default(false)
  adaptiveCruise      Boolean  @default(false)
  
  // Technical details
  vin                 String?
  chassisNumber       String?
}

model CarImage {
  id          String   @id @default(uuid())
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url         String
  isHero      Boolean  @default(false)
  is360       Boolean  @default(false)
  orderIndex  Int      @default(0)
}

model CrspValue {
  id          String   @id @default(uuid())
  make        String
  model       String
  trim        String?
  engineCc    Int?
  year        Int
  crspPrice   Decimal
  lastUpdated DateTime @default(now())

  @@index([make, model, year])
}

model Dealer {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  companyName   String
  licenseNumber String?
  website       String?
  location      String?
  rating        Decimal  @default(0)
  isVerified    Boolean  @default(false)
}

model Favorite {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  carId   String
  car     Car    @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Inspection {
  id           String   @id @default(uuid())
  carId        String
  car          Car      @relation(fields: [carId], references: [id])
  score        Int
  reportUrl    String?
  notes        String?
  createdAt    DateTime @default(now())
}
