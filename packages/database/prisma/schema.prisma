generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEALER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  PENDING
  SOLD
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  fullName      String?
  avatarUrl     String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listings      Car[]
  favorites     Favorite[]
  reviews       Review[]
  dealerProfile Dealer?
}

model Car {
  id                    String      @id @default(uuid())
  sellerId              String
  seller                User        @relation(fields: [sellerId], references: [id])
  
  // Identity
  vin                   String?     @unique
  chassisNumber         String?
  engineNumber          String?
  licensePlate          String?
  registrationDate      DateTime?
  manufactureDate       DateTime?
  importOrLocal         String?     // "Imported" or "Local"
  
  // Basic Info
  make                  String
  model                 String
  year                  Int
  price                 Decimal
  currency              String      @default("KES")
  mileage               Decimal?
  condition             Condition   @default(USED)
  status                CarStatus   @default(AVAILABLE)
  description           String?
  location              String?
  bodyType              String?
  category              String?
  features              String[]
  
  // Engagement
  viewsCount            Int         @default(0)
  likesCount            Int         @default(0)
  sharesCount           Int         @default(0)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  specs                 CarSpecs?
  images                CarImage[]
  favorites             Favorite[]
  reviews               Review[]
  inspections           Inspection[]
  history               CarHistory[]
}

model CarSpecs {
  id                    String   @id @default(uuid())
  carId                 String   @unique
  car                   Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  // Trim & Generation
  trimLevel             String?
  trimPackage           String?
  specialEdition        String?
  faceliftVersion       String?
  generationCode        String?
  
  // Deep Engine
  engineType            String?
  engineCc              Int?
  engineCode            String?
  horsepower            Int?
  torque                Int?
  fuelType              String?
  turbocharged          Boolean  @default(false)
  supercharged          Boolean  @default(false)
  turboCount            Int?
  intercooler           Boolean  @default(false)
  bore                  Decimal?
  stroke                Decimal?
  compressionRatio      String?
  valveTrain            String?
  
  // EV Data
  batteryCapacityKwh    Decimal?
  batteryType           String?
  rangeWltp             Int?
  fastChargeTime        Int?     // minutes
  
  // Drivetrain & Suspension
  transmission          String?
  drivetrain            String?
  differentialType      String?
  frontSuspension       String?
  rearSuspension        String?
  airSuspension         Boolean  @default(false)
  
  // Interior & Comfort
  seatingCapacity       Int?
  seatMaterial          String?
  heatedSeats           Boolean  @default(false)
  sunroof               Boolean  @default(false)
  ambientLighting       Boolean  @default(false)
  appleCarplay          Boolean  @default(false)
  androidAuto           Boolean  @default(false)
  
  // Safety
  airbagsCount          Int?
  abs                   Boolean  @default(true)
  laneAssist            Boolean  @default(false)
  blindSpotMonitor      Boolean  @default(false)
  safetyRating          String?
}

model CarImage {
  id          String   @id @default(uuid())
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  type        String   @default("GALLERY") // HERO, GALLERY, 360, INSPECTION
  url         String
  isHero      Boolean  @default(false)
  orderIndex  Int      @default(0)
}

model CarHistory {
  id            String   @id @default(uuid())
  carId         String
  car           Car      @relation(fields: [carId], references: [id])
  event         String   // "PRICE_DROP", "SOLD", "INSPECTED"
  oldValue      String?
  newValue      String?
  createdAt     DateTime @default(now())
}

model CrspValue {
  id          String   @id @default(uuid())
  make        String
  model       String
  trim        String?
  engineCc    Int?
  year        Int
  crspPrice   Decimal
  lastUpdated DateTime @default(now())

  @@index([make, model, year])
}

model Dealer {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  companyName   String
  licenseNumber String?
  website       String?
  location      String?
  rating        Decimal  @default(0)
  isVerified    Boolean  @default(false)
}

model Favorite {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  carId   String
  car     Car    @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Inspection {
  id           String   @id @default(uuid())
  carId        String
  car          Car      @relation(fields: [carId], references: [id])
  score        Int
  reportUrl    String?
  notes        String?
  createdAt    DateTime @default(now())
}
